{
  "name": "mercy-ministry-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:kiosk": "npm -w @mercy/kiosk run dev",
    "dev:admin": "npm -w @mercy/admin run dev",
    "build:shared": "npm -w @mercy/shared run build",
    "build:kiosk": "npm -w @mercy/shared run build && npm -w @mercy/kiosk run build",
    "build:admin": "npm -w @mercy/shared run build && npm -w @mercy/admin run build",
    "build": "npm -w @mercy/shared run build && npm -w @mercy/kiosk run build && npm -w @mercy/admin run build",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "analyze-bundle": "vite-bundle-analyzer"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.0",
    "@vitest/ui": "^2.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^7.15.0",
    "vitest": "^2.0.5",
    "husky": "^9.1.0",
    "rollup-plugin-visualizer": "^5.12.0"
  }
}
